# ── 강남대 이러닝캠퍼스 설정 (이 파일을 복사해 .env 로 만들고 채우세요) ──

# [권장] iCal 마감일 URL — 비밀번호 없이 마감일만 수집 (가장 안전)
#   구하는 법: 이러닝캠퍼스 로그인 → 캘린더 → "달력 내보내기(export)"
#   → 최근 및 향후 이벤트 선택 → "캘린더 URL 가져오기" 로 나오는 주소를 붙여넣기.
#   (calendar/export_execute.php?...userid=...&authtoken=... 형태)
ECAMPUS_ICAL_URL=

# [선택] 로그인 정보 — 제출여부 등 상세 스크래핑이 필요할 때만.
KNU_USERNAME=
KNU_PASSWORD=

# 기본 주소 (보통 그대로 둠)
ECAMPUS_BASE=https://ecampus.kangnam.ac.kr

# ── 로컬 AI (선택) ──
# 설치돼 있으면 자동 사용, 없으면 규칙 기반으로 동작.
#   LLM_BACKEND: auto(기본) | ollama | none
#   OLLAMA_HOST: http://localhost:11434
#   OLLAMA_MODEL: qwen2.5:7b  (한국어 되는 모델 권장)
LLM_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
